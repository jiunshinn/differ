# Differ — local environment variables
# Copy this file to `.env` (which is gitignored) and fill in the values.
# Loaded by the Electron main process at startup (electron/main.ts).

# --- GitHub OAuth (optional, for "Sign in with GitHub") ---
# Register an OAuth App at https://github.com/settings/developers,
# enable Device Flow on the app, and paste the Client ID below.
# The Client ID is public information — it's safe to ship in builds.
# Leave empty to disable OAuth sign-in (PAT sign-in still works).
DIFFER_GITHUB_OAUTH_CLIENT_ID=

# Optional — override the requested OAuth scopes.
# Default: "repo read:org read:user"
# DIFFER_GITHUB_OAUTH_SCOPES=repo read:org read:user
